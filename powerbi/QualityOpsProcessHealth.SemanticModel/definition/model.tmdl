model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_ProTooling = ["DevMode","DaxQueryView_Desktop"]

annotation PBI_QueryOrder = ["DatasetVersion","Measurement","Observation","Sensor","PostgreSQLServer","PostgreSQLDatabase","DatasetCode","VersionLabel","ContentFingerprint","SourceDatabase","CanonicalVersionRows","CanonicalVersionGuard"]

annotation __PBI_TimeIntelligenceEnabled = 0

ref table DatasetVersion
ref table Measurement
ref table Observation
ref table 'Process Health Measures'
ref table Sensor

ref cultureInfo en-US
